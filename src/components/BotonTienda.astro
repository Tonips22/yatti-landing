---
import { ENLACES_TIENDA } from "@/datos/tiendas";

interface Props {
	tienda: "ios" | "android";
}

const { tienda } = Astro.props;
const enlace = ENLACES_TIENDA[tienda];

const TIENDAS = {
	ios: {
		arriba: "Descárgala en el",
		abajo: "App Store",
		icono:
			"M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z",
	},
	android: {
		arriba: "Disponible en",
		abajo: "Google Play",
		icono:
			"M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM16.089 7.79L4.194 1.061 14.607 11.4zM4.194 22.939l11.895-6.72-1.482-1.494zM3.031 1.492v21.016l10.567-10.508z",
	},
} as const;

const { arriba, abajo, icono } = TIENDAS[tienda];
const base = "transicion-tema flex items-center gap-3 rounded-2xl px-5 py-3 text-left";
---

{
	enlace ? (
		<a
			href={enlace}
			target="_blank"
			rel="noopener"
			class={`${base} bg-foreground text-background transition-transform duration-200 hover:scale-105`}
		>
			<svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d={icono} />
			</svg>
			<span class="leading-tight">
				<span class="block text-[11px] opacity-70">{arriba}</span>
				<span class="block font-semibold text-lg">{abajo}</span>
			</span>
		</a>
	) : (
		<span
			class={`${base} cursor-not-allowed border border-glass-border bg-card text-muted`}
			aria-disabled="true"
		>
			<svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d={icono} />
			</svg>
			<span class="leading-tight">
				<span class="block text-[11px]">{abajo}</span>
				<span class="block font-semibold text-lg text-secondary">Próximamente</span>
			</span>
		</span>
	)
}
