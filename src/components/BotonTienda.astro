---
import { ENLACES_TIENDA } from "@/datos/tiendas";

interface Props {
	tienda: "ios" | "android";
}

const { tienda } = Astro.props;
const enlace = ENLACES_TIENDA[tienda];

const TIENDAS = {
	ios: {
		arriba: "Disponible para",
		abajo: "App Store",
		icono:
			"M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z",
	},
	android: {
		arriba: "Disponible en",
		abajo: "Google Play",
		icono:
			"M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM16.089 7.79L4.194	 1.061 14.607 11.4zM4.194 22.939l11.895-6.72-1.482-1.494zM3.031 1.492v21.016l10.567-10.508z",
	},
} as const;

const { arriba, abajo, icono } = TIENDAS[tienda];
/* Ancho FIJO (`w-56`), no el que pida el texto: «Descárgala en el / App Store»
   es más corto que «Google Play / Próximamente» y el de iOS salía más pequeño.
   Con el mismo ancho los dos botones se leen como pareja, en fila o apilados. */
const base = "flex w-56 items-center gap-3 rounded-2xl px-5 py-3 text-left";
---

{
	enlace ? (
		<a
			href={enlace}
			target="_blank"
			rel="noopener"
			class={`${base} boton-tienda bg-foreground text-background`}
		>
			{tienda === 'ios' ? (
				<img src="/images/apple-app-store-svgrepo-com.svg" class="h-10 w-10 shrink-0" alt="App Store" />
			) : (
				<img src="/images/google-play-store-svgrepo-com.svg" class="h-10 w-10 shrink-0" alt="Google Play" />
			)}
			<span class="leading-">
				<span class="block text-[11px] opacity-70">{arriba}</span>
				<span class="block font-semibold text-lg">{abajo}</span>
			</span>
		</a>
	) : (
		<span
			class={`${base} transicion-tema cursor-not-allowed border border-glass-border bg-card text-muted`}
			aria-disabled="true"
		>
			{tienda === 'ios' ? (
				<img src="/images/apple-app-store-svgrepo-com.svg" class="h-7 w-7 shrink-0" alt="App Store" />
			) : (
				<img src="/images/google-play-store-svgrepo-com.svg" class="h-7 w-7 shrink-0" alt="Google Play" />
			)}
			<span class="leading-tight">
				<span class="block text-[11px]">{abajo}</span>
				<span class="block font-semibold text-lg text-secondary">Próximamente</span>
			</span>
		</span>
	)
}

<style>
	/*
	 * El hover del botón activo.
	 *
	 * Antes era `hover:scale-105` de Tailwind y NO se notaba: `.transicion-tema`
	 * (globals.css) es CSS sin capa, que gana a las utilidades de Tailwind, y su
	 * `transition` solo lleva colores. El escalado se aplicaba de golpe, sin
	 * animar. Esta clase sustituye a `.transicion-tema` en el botón y lleva las
	 * dos cosas: los colores (cambio de tema) y el movimiento.
	 */
	.boton-tienda {
		transition:
			background-color 0.25s ease,
			border-color 0.25s ease,
			color 0.25s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	/* Sube un poco, crece un poco y gana sombra: se lee como "esto se pulsa". El
	   teclado recibe lo mismo, más el contorno de foco. */
	.boton-tienda:hover,
	.boton-tienda:focus-visible {
		transform: translateY(-2px) scale(1.03);
		box-shadow: 0 12px 28px -10px color-mix(in srgb, var(--color-primary) 55%, transparent);
	}

	.boton-tienda:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 3px;
	}

	.boton-tienda:active {
		transform: translateY(0) scale(0.98);
	}

	@media (prefers-reduced-motion: reduce) {
		.boton-tienda:hover,
		.boton-tienda:focus-visible,
		.boton-tienda:active {
			transform: none;
		}
	}
</style>
