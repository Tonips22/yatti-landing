---
/**
 * Simulador jugable del ciclo de una predicción, fiel a la `1.3.0` de la app.
 *
 * Cada paso es la pantalla real de la app reducida a lo esencial, y el texto
 * está copiado de ella (`new-prediction.tsx`, `prediction/[id].tsx`,
 * `opciones.tsx`, `eleccion-arbitro.tsx`, `resolucion.tsx`) para que lo que se
 * promete aquí sea lo que hay dentro. Las fórmulas de puntuación son las de
 * `lib/prediccion.ts` (clásicas) y `lib/multiple.ts` («Múltiple»).
 *
 * Desde la `1.2.0` no hay modos de liga: el árbitro es un interruptor de cada
 * predicción y el resultado cuenta al instante. La ventana de 48 h para
 * disputar se deja fuera a propósito: alargaba el simulador sin vender nada.
 */

const PASOS = [
	{ n: 1, nombre: "Crear" },
	{ n: 2, nombre: "Pronosticar" },
	{ n: 3, nombre: "Destapar" },
	{ n: 4, nombre: "Resolver" },
	{ n: 5, nombre: "Puntuar" },
];

/**
 * La liga del simulador: tú y cuatro más. El orden es la antigüedad en la
 * liga, que es el desempate de la elección de árbitro.
 */
const LIGA = ["Marta", "Dani", "Tú", "Laura", "Iván"];
const SUJETOS = ["Nadie en concreto", ...LIGA];

/** Clicar rellena la pregunta y ajusta el sujeto o las personas: es el atajo de la app. */
const EJEMPLOS_CLASICA = [
	{ texto: "¿Conseguirá Dani trabajo antes de octubre?", sujeto: "Dani" },
	{ texto: "¿Aguantará Laura la dieta hasta fin de mes?", sujeto: "Laura" },
	{ texto: "¿Se mudará Marta de piso este año?", sujeto: "Marta" },
	{ texto: "¿Volverán esos dos antes de Navidad?", sujeto: "Nadie en concreto" },
	{ texto: "¿Iván acabará la carrera en junio?", sujeto: "Iván" },
];

const EJEMPLOS_MULTIPLE = [
	{ texto: "¿Quién llegará tarde a la boda?", personas: ["Marta", "Dani", "Iván"] },
	{ texto: "¿Quién ligará antes esta noche?", personas: ["Tú", "Dani", "Laura", "Iván"] },
	{ texto: "¿Quién se dormirá primero en el viaje?", personas: ["Marta", "Laura", "Iván"] },
];

/** Los pronósticos de los demás en una clásica. Iván se esconde en el 50. */
const RIVALES = [
	{ nombre: "Marta", prob: 85 },
	{ nombre: "Dani", prob: 40 },
	{ nombre: "Laura", prob: 60 },
	{ nombre: "Iván", prob: 50 },
];

const PLACEHOLDER = {
	binaria: "¿Conseguirá Manuel trabajo antes de octubre?",
	multiple: "¿Quién llegará tarde a la boda?",
};
---

<script
	type="application/json"
	id="sim-datos"
	is:inline
	set:html={JSON.stringify({ rivales: RIVALES, liga: LIGA, placeholder: PLACEHOLDER })}
></script>

<section id="como-funciona" class="mx-auto max-w-3xl px-5 py-24">
	<div class="revelar text-center">
		<h2
			class="font-heading text-4xl font-bold tracking-tight text-foreground sm:text-5xl"
		>
			Cómo funciona
		</h2>
		<p class="mx-auto mt-4 max-w-xl text-secondary leading-relaxed">
			Una predicción entera, de principio a fin. Escribe la tuya, de Sí o No o
			entre varias personas, y juega los cinco pasos que usa la app.
		</p>
	</div>

	<div id="sim" class="revelar mt-12">
		<!-- ── Stepper ─────────────────────────────────────────── -->
		<div class="relative">
			<div
				class="absolute top-4 right-0 left-0 h-0.5 rounded-full bg-hairline"
				aria-hidden="true"
			>
				<div id="sim-progreso" class="h-full w-0 rounded-full bg-primary"></div>
			</div>

			<ol class="relative flex justify-between" role="tablist" aria-label="Pasos">
				{
					PASOS.map((paso) => (
						<li class="flex flex-col items-center gap-2">
							<button
								type="button"
								role="tab"
								class="paso group flex flex-col items-center gap-2"
								data-paso={paso.n}
								aria-selected={paso.n === 1 ? "true" : "false"}
							>
								<span class="bolita flex h-8 w-8 items-center justify-center rounded-full border-2 border-hairline bg-card font-semibold text-muted text-sm tabular-nums">
									{paso.n}
								</span>
								<span class="etiqueta hidden font-medium text-muted text-xs sm:block">
									{paso.nombre}
								</span>
							</button>
						</li>
					))
				}
			</ol>
		</div>

		<!-- ── Escenario ───────────────────────────────────────── -->
		<div
			id="sim-escenario"
			class="mt-8 overflow-hidden rounded-3xl border border-glass-border bg-surface"
		>
			<div id="sim-pista" class="flex min-h-[32rem] flex-col justify-center p-5 sm:min-h-[38rem] sm:p-7">
				<!-- 1 · Crear ─────────────────────────────────── -->
				<div class="panel" data-panel="1" role="tabpanel">
					<h3 data-escalonar class="font-heading text-xl font-bold text-foreground">
						Crea la predicción
					</h3>
					<p data-escalonar class="mt-2 text-secondary leading-relaxed">
						Dentro de una liga privada, con tus amigos y nadie más.{" "}
						<span data-solo="binaria">Una Clásica es de Sí o No.</span>
						<span data-solo="multiple" hidden
							>Una Múltiple va entre varias personas, y siempre lleva también
							«Nadie / Otro».</span
						>
					</p>

					<div
						data-escalonar
						class="mt-6 flex rounded-2xl border border-glass-border bg-card p-1"
						role="group"
						aria-label="Tipo de predicción"
					>
						<button
							type="button"
							class="tipo flex-1 rounded-xl px-4 py-2 font-semibold text-sm transition-colors"
							data-tipo="binaria"
							aria-pressed="true">Clásica</button
						>
						<button
							type="button"
							class="tipo flex-1 rounded-xl px-4 py-2 font-semibold text-sm transition-colors"
							data-tipo="multiple"
							aria-pressed="false">Múltiple</button
						>
					</div>

					<div data-solo="binaria">
						<p data-escalonar class="mt-6 mb-2 font-semibold text-foreground text-sm">
							¿Sobre quién va?
						</p>
						<div data-escalonar class="flex flex-wrap gap-2">
							{
								SUJETOS.map((m, i) => (
									<button
										type="button"
										class="sujeto rounded-full border border-glass-border bg-card px-3 py-1.5 text-secondary text-sm transition-colors"
										data-sujeto={m}
										aria-pressed={i === 0 ? "true" : "false"}
									>
										{m}
									</button>
								))
							}
						</div>
					</div>

					<div data-solo="multiple" hidden>
						<p data-escalonar class="mt-6 mb-2 font-semibold text-foreground text-sm">
							¿Entre quiénes?
						</p>
						<div data-escalonar class="flex flex-wrap gap-2">
							{
								LIGA.map((m) => (
									<button
										type="button"
										class="persona flex items-center gap-1.5 rounded-full border border-glass-border bg-card px-3 py-1.5 text-secondary text-sm transition-colors"
										data-persona={m}
										aria-pressed="false"
									>
										{m}
										<span class="marca" aria-hidden="true" hidden>✓</span>
									</button>
								))
							}
						</div>
						<p id="sim-minimo" data-escalonar class="mt-2 text-muted text-xs">
							Marca al menos dos personas.
						</p>
					</div>

					<label
						data-escalonar
						for="sim-pregunta"
						class="mt-6 mb-2 block font-semibold text-foreground text-sm"
					>
						La pregunta
					</label>
					<textarea
						data-escalonar
						id="sim-pregunta"
						rows="2"
						maxlength="280"
						placeholder={PLACEHOLDER.binaria}
						class="w-full resize-none rounded-2xl border border-glass-border bg-card px-4 py-3 text-foreground leading-relaxed outline-none transition-colors placeholder:text-muted focus:border-primary"
					></textarea>
					<p class="mt-1 text-right text-muted text-xs tabular-nums">
						<span id="sim-cuenta">0</span>/280
					</p>

					<div data-escalonar data-solo="binaria" class="mt-3 flex flex-wrap gap-2">
						{
							EJEMPLOS_CLASICA.map((e) => (
								<button
									type="button"
									class="ejemplo rounded-full border border-dashed border-glass-border px-3 py-1.5 text-left text-muted text-xs transition-colors hover:border-primary hover:text-primary"
									data-texto={e.texto}
									data-sujeto={e.sujeto}
								>
									{e.texto}
								</button>
							))
						}
					</div>
					<div data-escalonar data-solo="multiple" hidden class="mt-3 flex flex-wrap gap-2">
						{
							EJEMPLOS_MULTIPLE.map((e) => (
								<button
									type="button"
									class="ejemplo rounded-full border border-dashed border-glass-border px-3 py-1.5 text-left text-muted text-xs transition-colors hover:border-primary hover:text-primary"
									data-texto={e.texto}
									data-personas={e.personas.join(",")}
								>
									{e.texto}
								</button>
							))
						}
					</div>

					<div data-escalonar class="mt-6 flex items-center gap-3">
						<div class="flex-1">
							<p class="font-semibold text-foreground">Elegir árbitro</p>
							<p class="text-muted text-sm leading-5">
								El grupo vota quién la resuelve.
							</p>
						</div>
						<button
							type="button"
							role="switch"
							id="sim-arbitro"
							aria-checked="false"
							aria-label="Elegir árbitro"
							class="relative h-7 w-12 shrink-0 rounded-full transition-colors"
						>
							<span
								class="perilla absolute top-0.5 left-0.5 block h-6 w-6 rounded-full bg-white shadow"
							></span>
						</button>
					</div>
				</div>

				<!-- 2 · Pronosticar ───────────────────────────── -->
				<div class="panel" data-panel="2" role="tabpanel" hidden>
					<h3 data-escalonar class="font-heading text-xl font-bold text-foreground">
						<span data-solo="binaria">Pon tu porcentaje</span>
						<span data-solo="multiple" hidden>Reparte tu 100 %</span>
					</h3>
					<p data-escalonar class="mt-2 text-secondary leading-relaxed">
						<span data-solo="binaria"
							>10 % si lo ves imposible, 90 % si lo tienes clarísimo.</span
						>
						<span data-solo="multiple" hidden
							>De 5 en 5, entre todas las opciones, hasta llegar a 100. Cuanto
							más le des a quien acabe siendo, mejor.</span
						>{" "}
						Nadie ve el de los demás hasta que cierra el plazo.
					</p>

					<!-- Clásica: el deslizador -->
					<div
						data-escalonar
						data-solo="binaria"
						class="mt-6 rounded-2xl border border-glass-border bg-card p-5"
					>
						<p class="text-muted text-sm" data-eco-pregunta></p>

						<p
							id="sim-valor"
							class="mt-4 text-center font-heading text-6xl font-bold tabular-nums sm:text-7xl"
							aria-hidden="true"
						>
							73 %
						</p>
						<p class="mt-2 text-center text-secondary">
							¿Qué probabilidad le das a que ocurra?
						</p>

						<div class="mt-4 flex justify-between text-xs">
							<span class="text-danger">No lo veo</span>
							<span class="text-success">Seguro</span>
						</div>
						<label for="sim-prob" class="sr-only">Tu porcentaje</label>
						<input
							id="sim-prob"
							type="range"
							min="0"
							max="100"
							step="1"
							value="73"
							class="w-full"
						/>

						<p
							id="sim-cobardia"
							class="mt-3 rounded-xl bg-warning-soft px-3 py-2 text-[13px] text-warning leading-relaxed"
							hidden
						>
							Un 50 % clavado es no mojarse: da lo mismo pase lo que pase. Nunca
							te hundes, pero nunca ganas.
						</p>

						<button
							type="button"
							id="sim-sellar"
							class="mt-5 w-full rounded-2xl bg-primary px-6 py-3.5 font-semibold text-on-primary transition-colors hover:bg-primary-hover"
						>
							Sellar mi pronóstico
						</button>

						<p class="mt-3 text-center text-muted text-xs">
							🔒 Nadie ve los pronósticos hasta que cierra
						</p>
					</div>

					<!-- Múltiple: el reparto con ±5 -->
					<div
						data-escalonar
						data-solo="multiple"
						hidden
						class="mt-6 rounded-2xl border border-glass-border bg-card p-5"
					>
						<p class="text-muted text-sm" data-eco-pregunta></p>

						<div class="mt-4 flex items-baseline justify-between">
							<span class="text-secondary">Reparte tu 100%</span>
							<span
								id="sim-repartido"
								class="font-heading text-3xl font-bold tabular-nums text-primary"
								>0%</span
							>
						</div>
						<div class="mt-2 h-3.5 overflow-hidden rounded-full bg-hairline">
							<span
								id="sim-repartido-barra"
								class="block h-full w-0 rounded-full bg-primary"></span>
						</div>

						<ul id="sim-reparto" class="mt-5 grid gap-3"></ul>

						<p
							id="sim-quedan"
							class="mt-4 text-center font-medium text-muted text-sm tabular-nums"
						>
							Te quedan 100%
						</p>

						<button
							type="button"
							id="sim-sellar-reparto"
							class="mt-4 w-full rounded-2xl bg-primary px-6 py-3.5 font-semibold text-on-primary transition-colors hover:bg-primary-hover disabled:opacity-40"
							disabled
						>
							Sellar mi reparto
						</button>

						<p class="mt-3 text-center text-muted text-xs">
							🔒 Nadie ve los repartos hasta que cierra
						</p>
					</div>

					<div
						data-escalonar
						class="mt-5 flex items-center gap-2 border-hairline border-t pt-4"
					>
						<span class="text-muted text-sm">Los demás:</span>
						{
							RIVALES.map(() => (
								<span class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-soft font-semibold text-muted text-xs">
									?
								</span>
							))
						}
					</div>

					<!-- La elección de árbitro, a la vez que el pronóstico -->
					<div
						data-escalonar
						data-solo="arbitro"
						hidden
						class="mt-5 rounded-2xl border border-glass-border bg-card p-5"
					>
						<p class="text-center font-semibold text-foreground">
							⚖️ ¿Quién arbitra esta?
						</p>
						<p class="mt-1 text-center text-muted text-sm">
							Se decide ahora, antes de saber cómo acaba.
						</p>
						<ul id="sim-eleccion" class="mt-4 grid gap-2"></ul>
						<p class="mt-4 text-center text-muted text-xs leading-5">
							Arbitra quien más votos reciba. En caso de empate, quien lleve más
							tiempo en la liga. Puedes cambiar tu voto hasta el cierre, pero no
							votarte a ti mismo.
						</p>
					</div>
				</div>

				<!-- 3 · Destapar ──────────────────────────────── -->
				<div class="panel" data-panel="3" role="tabpanel" hidden>
					<h3 data-escalonar class="font-heading text-xl font-bold text-foreground">
						Se cierra el plazo y se destapa todo
					</h3>

					<p class="mt-5 text-muted text-sm" data-eco-pregunta></p>

					<p data-solo="arbitro" hidden class="mt-3">
						<span
							class="inline-flex items-center gap-1.5 rounded-full border border-warning bg-warning-soft px-3 py-1 font-medium text-warning text-xs"
						>
							⚖️ Arbitra <span data-eco-arbitro></span>
						</span>
					</p>

					<div data-solo="binaria">
						<ul id="sim-destape" class="mt-4 grid gap-2"></ul>

						<div
							class="mt-4 flex items-center justify-between rounded-2xl border border-glass-border bg-card px-4 py-3"
						>
							<span class="text-secondary text-sm">El grupo dijo</span>
							<span id="sim-media" class="font-heading font-bold text-lg tabular-nums"
								>0 %</span
							>
						</div>
					</div>

					<div data-solo="multiple" hidden>
						<p class="mt-4 mb-2 font-semibold text-foreground text-sm">
							El grupo dijo
						</p>
						<ul
							id="sim-medias"
							class="grid gap-3 rounded-2xl border border-glass-border bg-card p-4"
						>
						</ul>
						<p class="mt-5 mb-2 font-semibold text-foreground text-sm">
							Cómo repartió cada uno
						</p>
						<ul
							id="sim-repartos"
							class="overflow-hidden rounded-2xl border border-glass-border bg-card"
						>
						</ul>
						<p
							data-sin-reparto
							hidden
							class="mt-3 rounded-xl bg-warning-soft px-3 py-2 text-[13px] text-warning leading-relaxed"
						>
							Tu reparto no llegaba al 100 %, así que no entra. Vuelve al paso 2 y
							termina de repartir.
						</p>
					</div>

					<button
						type="button"
						id="sim-repetir"
						class="mt-4 text-muted text-sm underline transition-colors hover:text-primary"
					>
						Volver a destapar
					</button>
				</div>

				<!-- 4 · Resolver ──────────────────────────────── -->
				<div class="panel" data-panel="4" role="tabpanel" hidden>
					<h3 data-escalonar class="font-heading text-xl font-bold text-foreground">
						Llega la fecha y se resuelve
					</h3>
					<p data-escalonar class="mt-2 text-secondary leading-relaxed">
						<span data-solo="sin-arbitro"
							>La resuelve quien la creó, o la persona de la que va.</span
						>
						<span data-solo="arbitro" hidden
							>La resuelve <strong class="text-foreground" data-eco-arbitro></strong>,
							a quien eligió el grupo antes de saber cómo acababa.</span
						>{" "}
						Cuenta al momento: sello, clasificación y aviso a todos.
					</p>

					<div
						data-escalonar
						class="mt-5 rounded-2xl border border-glass-border bg-card p-5"
					>
						<p class="text-center font-semibold text-foreground">
							<span data-solo="binaria">¿Ocurrió al final?</span>
							<span data-solo="multiple" hidden>¿Quién fue al final?</span>
						</p>

						<div data-solo="binaria" class="mt-4 grid grid-cols-2 gap-3">
							<button
								type="button"
								class="resultado rounded-2xl border-2 px-4 py-3.5 font-bold text-lg transition-colors"
								data-resultado="si"
								aria-pressed="true">Sí</button
							>
							<button
								type="button"
								class="resultado rounded-2xl border-2 px-4 py-3.5 font-bold text-lg transition-colors"
								data-resultado="no"
								aria-pressed="false">No</button
							>
						</div>

						<ul id="sim-ganadoras" data-solo="multiple" hidden class="mt-4 grid gap-2"></ul>

						<button
							type="button"
							id="sim-anular"
							aria-pressed="false"
							class="mt-3 w-full rounded-xl px-4 py-2 font-medium text-secondary text-sm transition-colors hover:bg-hairline"
						>
							Anular
						</button>
						<p class="mt-1 text-center text-muted text-xs">
							Anula si la pregunta resultó ambigua o ya no aplica.
						</p>
					</div>
				</div>

				<!-- 5 · Puntuar ───────────────────────────────── -->
				<div class="panel" data-panel="5" role="tabpanel" hidden>
					<h3 data-escalonar class="font-heading text-xl font-bold text-foreground">
						La clasificación se mueve
					</h3>
					<p data-escalonar class="mt-2 text-secondary leading-relaxed">
						Yatti puntúa con el <strong class="text-foreground">Brier score</strong>,
						la regla que usan los forecasters serios. Premia acertar <em>y</em> ser
						sincero con tu confianza.
					</p>

					<div
						id="sim-anulada"
						hidden
						data-escalonar
						class="mt-6 rounded-2xl border border-glass-border bg-card p-5 text-center"
					>
						<p class="font-heading text-2xl font-bold text-muted">Anulada</p>
						<p class="mt-2 text-secondary text-sm leading-relaxed">
							No puntúa a nadie y la clasificación se queda como estaba. Es la
							válvula de escape para las preguntas que no se pueden resolver.
						</p>
					</div>

					<div id="sim-marcador">
						<div
							data-escalonar
							class="mt-6 rounded-2xl border border-glass-border bg-card p-5"
							aria-live="polite"
						>
							<p id="sim-resumen" class="text-muted text-sm"></p>
							<div id="sim-mi-indice">
								<p class="mt-3 flex items-baseline gap-2">
									<span
										id="sim-indice"
										class="font-heading text-5xl font-bold tabular-nums">91</span
									>
									<span class="text-muted text-sm">índice de acierto (0-100)</span>
								</p>
								<p class="mt-2 text-muted text-[13px]">
									Brier = <span id="sim-brier" class="tabular-nums">0.090</span> ·
									índice = (1 − Brier) × 100
								</p>
								<p id="sim-formula-multiple" class="mt-1 text-muted text-[13px]" hidden>
									En una Múltiple, Brier = Σ (resultado − %)² / 2 sobre todas las
									opciones: con dos, da lo mismo que una de Sí o No.
								</p>
							</div>
						</div>

						<p data-escalonar class="mt-8 mb-3 font-semibold text-foreground text-sm">
							Clasificación de la ronda
						</p>
						<ol
							id="sim-tabla"
							class="overflow-hidden rounded-2xl border border-glass-border bg-card"
						>
						</ol>
						<p data-escalonar class="mt-3 text-muted text-xs leading-relaxed">
							La liga ordena por Brier <strong>medio</strong>, no acumulado: una
							mala racha no te hunde de por vida. Las Múltiple y las de Sí o No
							suman en la misma clasificación. Y hay tabla del mes, para que
							siempre haya carrera nueva.
						</p>
					</div>
				</div>
			</div>
		</div>

		<!-- ── Navegación ──────────────────────────────────────── -->
		<div class="mt-5 flex gap-3">
			<button
				type="button"
				id="sim-atras"
				class="rounded-2xl border border-glass-border bg-card px-5 py-3 font-semibold text-secondary transition-colors hover:border-primary hover:text-primary disabled:opacity-40"
				disabled>Atrás</button
			>
			<button
				type="button"
				id="sim-siguiente"
				class="flex-1 rounded-2xl bg-primary px-6 py-3 font-semibold text-on-primary transition-colors hover:bg-primary-hover"
				>Siguiente paso</button
			>
		</div>
	</div>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* El pulgar del deslizador es EL gesto de la app; el nativo sale en el azul
	   del sistema y rompe la marca. Es lo único que Tailwind no alcanza. */
	#sim-prob {
		appearance: none;
		-webkit-appearance: none;
		height: 2.5rem;
		background: transparent;
		cursor: pointer;
	}
	#sim-prob::-webkit-slider-runnable-track {
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-primary-soft);
	}
	#sim-prob::-webkit-slider-thumb {
		appearance: none;
		-webkit-appearance: none;
		margin-top: -0.5rem;
		height: 1.5rem;
		width: 1.5rem;
		border-radius: 999px;
		border: 3px solid var(--color-card);
		background: var(--color-primary);
		box-shadow: 0 2px 10px var(--color-scrim);
	}
	#sim-prob::-moz-range-track {
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-primary-soft);
	}
	#sim-prob::-moz-range-thumb {
		height: 1.5rem;
		width: 1.5rem;
		border-radius: 999px;
		border: 3px solid var(--color-card);
		background: var(--color-primary);
	}
</style>

<script>
	import { animate, spring, stagger } from "motion";

	const MUELLE = { type: spring, stiffness: 320, damping: 32, mass: 0.9 };
	const MUELLE_SUAVE = { type: spring, stiffness: 180, damping: 26 };

	const datos = JSON.parse(
		document.getElementById("sim-datos")!.textContent!,
	) as {
		rivales: { nombre: string; prob: number }[];
		liga: string[];
		placeholder: { binaria: string; multiple: string };
	};

	const RIVALES = datos.rivales;
	const LIGA = datos.liga;
	const NOMBRES_RIVALES = RIVALES.map((r) => r.nombre);

	/** La opción que añade siempre el servidor (`crear_prediccion_multiple`). */
	const NADIE = "Nadie / Otro";

	/** Lo que fija la app: ±5 por toque (`opciones.tsx`). */
	const PASO = 5;

	type Reparto = Record<string, number>;

	/* ── Las cuentas, copiadas de la app ─────────────────────── */

	/** Mismas fórmulas que `lib/prediccion.ts` en el repo de la app. */
	const brierDe = (prob: number, ocurrio: boolean) =>
		((ocurrio ? 1 : 0) - prob / 100) ** 2;
	const indiceDe = (prob: number, ocurrio: boolean) =>
		Math.round((1 - brierDe(prob, ocurrio)) * 100);

	/** `brierMultiple` de `lib/multiple.ts`: Σ (o − p)² / 2. */
	function brierMultiple(reparto: Reparto, ganadora: string) {
		const ids = new Set([...Object.keys(reparto), ganadora]);
		let suma = 0;
		for (const id of ids) {
			const p = (reparto[id] ?? 0) / 100;
			const o = id === ganadora ? 1 : 0;
			suma += (o - p) ** 2;
		}
		return suma / 2;
	}
	const indiceMultiple = (reparto: Reparto, ganadora: string) =>
		Math.round((1 - brierMultiple(reparto, ganadora)) * 100);

	const quedan = (reparto: Reparto) =>
		100 - Object.values(reparto).reduce((a, b) => a + b, 0);

	/** `mover` de `lib/multiple.ts`: solo toca ESA opción y nunca se pasa de 100. */
	function mover(reparto: Reparto, id: string, delta: number): Reparto {
		const actual = reparto[id] ?? 0;
		const tope = actual + Math.max(quedan(reparto), 0);
		const nuevo = Math.min(Math.max(actual + delta, 0), tope);
		return { ...reparto, [id]: nuevo };
	}

	/** Misma escala que `colorProbabilidad()` en la app. */
	function colorProb(v: number) {
		if (v >= 100) return "var(--color-prob-total)";
		if (v >= 70) return "var(--color-prob-alta)";
		if (v >= 50) return "var(--color-prob-media)";
		if (v >= 30) return "var(--color-prob-baja)";
		return "var(--color-prob-muy-baja)";
	}

	/**
	 * `tramosDeColor` + `colorDeTramo` de la app: en un reparto el color sale
	 * del PUESTO, no del valor (con ocho opciones nadie pasa del 30 %).
	 */
	const TRAMOS = [
		"var(--color-prob-total)",
		"var(--color-prob-alta)",
		"var(--color-prob-media)",
		"var(--color-prob-baja)",
		"var(--color-prob-muy-baja)",
	];
	function coloresDeReparto(reparto: Reparto): Record<string, string | null> {
		const distintos = [
			...new Set(Object.values(reparto).filter((v) => v > 0)),
		].sort((a, b) => b - a);
		const ultimo = distintos.length - 1;
		return Object.fromEntries(
			Object.entries(reparto).map(([id, v]) => {
				if (v <= 0) return [id, null];
				const puesto = distintos.indexOf(v);
				return [id, TRAMOS[ultimo === 0 ? 0 : Math.round((puesto * 4) / ultimo)]];
			}),
		);
	}

	/* ── Los repartos de los demás ───────────────────────────── */

	function hash(s: string) {
		let h = 7;
		for (const c of s) h = (h * 31 + c.charCodeAt(0)) | 0;
		return Math.abs(h);
	}

	/** Cuánto se moja cada uno: Marta lo concentra todo, Iván lo reparte. */
	const CONCENTRACION: Record<string, number> = {
		Marta: 3,
		Dani: 1.8,
		Laura: 2.4,
		Iván: 0.6,
	};

	/**
	 * Un reparto creíble y estable para un rival: mismo nombre y mismas
	 * opciones, mismo reparto. Pesos pseudoaleatorios, afilados según el
	 * carácter de cada uno y redondeados a múltiplos de 5 que suman 100.
	 */
	function repartoDe(nombre: string, opciones: string[]): Reparto {
		const pesos = opciones.map((o) => {
			const base = o === NADIE ? 0.35 : 0.4 + (hash(nombre + o) % 100) / 100;
			return base ** (CONCENTRACION[nombre] ?? 1);
		});
		const total = pesos.reduce((a, b) => a + b, 0);
		const unidades = pesos.map((p) => (p / total) * (100 / PASO));
		const enteras = unidades.map(Math.floor);
		let sobran = 100 / PASO - enteras.reduce((a, b) => a + b, 0);
		const porResto = unidades
			.map((u, i) => ({ i, resto: u - Math.floor(u) }))
			.sort((a, b) => b.resto - a.resto);
		for (const { i } of porResto) {
			if (sobran-- <= 0) break;
			enteras[i]++;
		}
		return Object.fromEntries(opciones.map((o, i) => [o, enteras[i] * PASO]));
	}

	/* ── La página ───────────────────────────────────────────── */

	const raiz = document.getElementById("sim");

	if (raiz) {
		const q = <T extends HTMLElement>(sel: string) =>
			raiz.querySelector(sel) as T;
		const qa = <T extends HTMLElement>(sel: string) => [
			...raiz.querySelectorAll<T>(sel),
		];

		const pasos = qa<HTMLButtonElement>(".paso");
		const paneles = qa<HTMLElement>(".panel");
		const pista = q<HTMLElement>("#sim-pista");
		const escenario = q<HTMLElement>("#sim-escenario");
		const progreso = q<HTMLElement>("#sim-progreso");
		const siguiente = q<HTMLButtonElement>("#sim-siguiente");
		const atras = q<HTMLButtonElement>("#sim-atras");

		const pregunta = q<HTMLTextAreaElement>("#sim-pregunta");
		const cuenta = q<HTMLElement>("#sim-cuenta");
		const interruptor = q<HTMLButtonElement>("#sim-arbitro");
		const deslizador = q<HTMLInputElement>("#sim-prob");
		const valor = q<HTMLElement>("#sim-valor");
		const cobardia = q<HTMLElement>("#sim-cobardia");
		const sellar = q<HTMLButtonElement>("#sim-sellar");
		const listaReparto = q<HTMLElement>("#sim-reparto");
		const sellarReparto = q<HTMLButtonElement>("#sim-sellar-reparto");
		const eleccion = q<HTMLElement>("#sim-eleccion");
		const destape = q<HTMLElement>("#sim-destape");
		const media = q<HTMLElement>("#sim-media");
		const tabla = q<HTMLElement>("#sim-tabla");

		const estado = {
			paso: 1,
			tipo: "binaria" as "binaria" | "multiple",
			sujeto: "Nadie en concreto",
			/** Las personas de una Múltiple, en el orden en que se marcan. */
			personas: ["Marta", "Dani", "Laura"],
			conArbitro: false,
			prob: 73,
			reparto: {} as Reparto,
			/** Voto de árbitro de cada uno. El tuyo empieza vacío. */
			votosArbitro: {
				Marta: "Dani",
				Dani: "Laura",
				Laura: "Dani",
				Iván: "Laura",
			} as Record<string, string>,
			resultado: true,
			ganadora: "Marta",
			anulada: false,
		};

		const multiple = () => estado.tipo === "multiple";
		const opciones = () => [...estado.personas, NADIE];
		const textoPregunta = () =>
			pregunta.value.trim() || datos.placeholder[estado.tipo];
		const repartoCompleto = () =>
			multiple() && quedan(estado.reparto) === 0;

		/** Cómo se lee una opción: «Tú» va tal cual, como en la app («· tú»). */
		const cara = (o: string) =>
			o === NADIE ? "?" : o === "Tú" ? "Tú" : o.slice(0, 1);

		/** El árbitro proclamado: más votos y, si empatan, más antigüedad. */
		function arbitro() {
			const votos = Object.values(estado.votosArbitro);
			let mejor = LIGA[0];
			let max = -1;
			for (const c of LIGA) {
				const n = votos.filter((v) => v === c).length;
				if (n > max) {
					max = n;
					mejor = c;
				}
			}
			return mejor;
		}

		/* ── Animaciones base ──────────────────────────────────── */

		function numero(el: HTMLElement, desde: number, hasta: number, sufijo = "") {
			animate(desde, hasta, {
				duration: 0.5,
				onUpdate: (v) => {
					el.textContent = Math.round(v) + sufijo;
				},
			});
		}

		/** Una fila con barra que se llena, como la `BarraAnimada` de la app. */
		function llenar(barras: HTMLElement[], anchos: number[], retraso = 0.08) {
			barras.forEach((barra, i) => {
				animate(
					barra,
					{ width: ["0%", anchos[i] + "%"] },
					{ ...MUELLE_SUAVE, delay: retraso * i + 0.1 },
				);
			});
		}

		let transicionando = false;

		/** Lo que mide el escenario ahora mismo, aunque esté a mitad de animación. */
		const alturaVisible = () => escenario.getBoundingClientRect().height;

		let animacionAltura = 0;

		/**
		 * Lleva el escenario de `antes` a lo que pide su contenido, con muelle en
		 * vez de salto. El turno evita que una animación vieja, al terminar,
		 * suelte la altura en mitad de la nueva (cambiar de tipo dos veces seguidas).
		 */
		function animarAltura(antes: number) {
			const borde = escenario.offsetHeight - escenario.clientHeight;
			const despues = pista.offsetHeight + borde;
			if (Math.abs(despues - antes) <= 4) {
				escenario.style.height = "";
				return;
			}
			const turno = ++animacionAltura;
			escenario.style.height = antes + "px";
			animate(
				escenario,
				{ height: [antes + "px", despues + "px"] },
				MUELLE_SUAVE,
			).finished.then(() => {
				if (turno === animacionAltura) escenario.style.height = "";
			});
		}

		/**
		 * Cambia lo que se ve dentro del panel (Clásica ↔ Múltiple, el árbitro)
		 * sin que la caja salte: la altura se anima y lo que aparece entra con
		 * un fundido.
		 */
		function cambiarDentro(cambio: () => void) {
			const antes = alturaVisible();
			const visibles = new Set(qa<HTMLElement>("[data-solo]").filter((e) => !e.hidden));
			escenario.style.height = antes + "px";
			cambio();
			const nuevos = qa<HTMLElement>("[data-solo]").filter(
				(e) => !e.hidden && !visibles.has(e) && !e.closest(".panel[hidden]"),
			);
			animarAltura(antes);
			if (nuevos.length) {
				animate(
					nuevos,
					{ opacity: [0, 1], y: [8, 0] },
					{ ...MUELLE, delay: stagger(0.03) },
				);
			}
		}

		/**
		 * Borra los restos de una transición anterior. Sin esto, el panel
		 * conserva la opacidad y el desenfoque con los que salió, y al volver a
		 * él (Atrás, o «Volver al principio») aparece velado.
		 */
		function limpiar(panel: HTMLElement) {
			panel.style.opacity = "";
			panel.style.transform = "";
			panel.style.filter = "";
			for (const h of panel.querySelectorAll<HTMLElement>("[data-escalonar]")) {
				h.style.opacity = "";
				h.style.transform = "";
			}
		}

		async function cambiarPanel(destino: number, preparar?: () => void) {
			const saliente = paneles.find((p) => !p.hidden)!;
			const entrante = paneles[destino - 1];
			if (saliente === entrante) return;

			/* Solo los visibles: los de la otra clase de predicción se quedan
			   ocultos y no cuentan para el escalonado. */
			const hijos = [
				...entrante.querySelectorAll<HTMLElement>("[data-escalonar]"),
			].filter((h) => {
				for (let e: HTMLElement | null = h; e && e !== entrante; e = e.parentElement) {
					if (e.hidden) return false;
				}
				return true;
			});

			/* Se oculta ANTES de quitarle el `hidden`. Al revés, el navegador
			   alcanza a pintar un fotograma a opacidad plena antes de que arranque
			   la animación: eso es el parpadeo. */
			entrante.style.opacity = "0";
			for (const h of hijos) h.style.opacity = "0";

			const alturaAntes = alturaVisible();

			await animate(saliente, { opacity: 0, y: -8 }, { duration: 0.14 })
				.finished;
			saliente.hidden = true;
			limpiar(saliente);
			entrante.hidden = false;

			/* El contenido se rellena aquí, antes de medir: si se mide el panel
			   vacío, la altura calculada es la equivocada y de ahí el salto. */
			preparar?.();

			animarAltura(alturaAntes);

			await Promise.all([
				animate(entrante, { opacity: [0, 1], y: [14, 0] }, MUELLE).finished,
				hijos.length
					? animate(
							hijos,
							{ opacity: [0, 1], y: [12, 0] },
							{ ...MUELLE, delay: stagger(0.04, { startDelay: 0.05 }) },
						).finished
					: Promise.resolve(),
			]);
			limpiar(entrante);
		}

		function pintarStepper() {
			for (const paso of pasos) {
				const n = Number(paso.dataset.paso);
				const activo = n === estado.paso;
				const hecho = n < estado.paso;
				paso.setAttribute("aria-selected", String(activo));
				const bolita = paso.querySelector(".bolita") as HTMLElement;
				const etiqueta = paso.querySelector(".etiqueta") as HTMLElement;

				bolita.style.borderColor =
					activo || hecho ? "var(--color-primary)" : "var(--color-hairline)";
				bolita.style.background = hecho
					? "var(--color-primary)"
					: "var(--color-card)";
				bolita.style.color = hecho
					? "var(--color-on-primary)"
					: activo
						? "var(--color-primary)"
						: "var(--color-muted)";
				etiqueta.style.color = activo
					? "var(--color-primary)"
					: "var(--color-muted)";

				if (activo) animate(bolita, { scale: [1, 1.18, 1] }, { duration: 0.42 });
			}

			const pct = ((estado.paso - 1) / (pasos.length - 1)) * 100;
			animate(progreso, { width: pct + "%" }, MUELLE_SUAVE);
		}

		/** Enseña lo de la clase de predicción elegida, y lo del árbitro si va. */
		function pintarVisibilidad() {
			for (const el of qa<HTMLElement>("[data-solo]")) {
				const solo = el.dataset.solo;
				el.hidden =
					solo === "arbitro"
						? !estado.conArbitro
						: solo === "sin-arbitro"
							? estado.conArbitro
							: solo !== estado.tipo;
			}
		}

		async function irA(n: number) {
			const destino = Math.min(Math.max(n, 1), paneles.length);
			if (transicionando || destino === estado.paso) return;

			/* Como el botón Crear de la app: sin dos personas no hay Múltiple. */
			if (destino > 1 && multiple() && estado.personas.length < 2) {
				if (estado.paso !== 1) await irA(1);
				const aviso = q<HTMLElement>("#sim-minimo");
				aviso.style.color = "var(--color-danger)";
				animate(aviso, { x: [0, -6, 6, -4, 4, 0] }, { duration: 0.4 });
				return;
			}

			transicionando = true;
			estado.paso = destino;

			pintarStepper();
			atras.disabled = destino === 1;
			siguiente.textContent =
				destino === paneles.length ? "Volver al principio" : "Siguiente paso";

			try {
				await cambiarPanel(destino, () => {
					for (const eco of qa<HTMLElement>("[data-eco-pregunta]")) {
						eco.textContent = textoPregunta();
					}
					for (const eco of qa<HTMLElement>("[data-eco-arbitro]")) {
						eco.textContent = arbitro();
					}
					if (destino === 2) {
						pintarReparto(true);
						pintarEleccion();
					}
					if (destino === 3) destapar();
					if (destino === 4) pintarResolver();
					if (destino === 5) pintarMarcador();
				});
			} finally {
				transicionando = false;
			}
		}

		/* ── Paso 1 ────────────────────────────────────────────── */

		/** El estilo de «elegido» de los chips de personas, como en la app. */
		function marcarChip(b: HTMLElement, activo: boolean) {
			b.setAttribute("aria-pressed", String(activo));
			b.style.borderColor = activo
				? "var(--color-accent)"
				: "var(--color-glass-border)";
			b.style.background = activo ? "var(--color-accent-soft)" : "var(--color-card)";
			b.style.color = activo ? "var(--color-foreground)" : "var(--color-secondary)";
			b.style.fontWeight = activo ? "600" : "";
		}

		function elegirTipo(tipo: "binaria" | "multiple") {
			estado.tipo = tipo;
			for (const b of qa<HTMLButtonElement>(".tipo")) {
				const activo = b.dataset.tipo === tipo;
				b.setAttribute("aria-pressed", String(activo));
				b.style.background = activo ? "var(--color-primary-soft)" : "transparent";
				b.style.color = activo ? "var(--color-primary)" : "var(--color-muted)";
			}
			pregunta.placeholder = datos.placeholder[tipo];
			pintarVisibilidad();
		}

		for (const b of qa<HTMLButtonElement>(".tipo")) {
			b.addEventListener("click", () => {
				if (b.dataset.tipo === estado.tipo) return;
				cambiarDentro(() => elegirTipo(b.dataset.tipo as "binaria" | "multiple"));
				animate(b, { scale: [1, 0.96, 1] }, { duration: 0.25 });
			});
		}

		pregunta.addEventListener("input", () => {
			cuenta.textContent = String(pregunta.value.length);
		});

		for (const chip of qa<HTMLButtonElement>(".ejemplo")) {
			chip.addEventListener("click", () => {
				pregunta.value = chip.dataset.texto!;
				cuenta.textContent = String(pregunta.value.length);
				if (chip.dataset.sujeto) elegirSujeto(chip.dataset.sujeto);
				if (chip.dataset.personas)
					elegirPersonas(chip.dataset.personas.split(","));
				animate(pregunta, { scale: [1, 1.015, 1] }, { duration: 0.35 });
				animate(chip, { scale: [1, 0.94, 1] }, { duration: 0.25 });
			});
		}

		function elegirSujeto(nombre: string) {
			estado.sujeto = nombre;
			for (const b of qa<HTMLButtonElement>(".sujeto")) {
				marcarChip(b, b.dataset.sujeto === nombre);
			}
		}

		for (const b of qa<HTMLButtonElement>(".sujeto")) {
			b.addEventListener("click", () => elegirSujeto(b.dataset.sujeto!));
		}

		function elegirPersonas(personas: string[]) {
			estado.personas = personas;
			/* Lo repartido a quien ya no es opción se pierde, como al rehacer la
			   predicción: el reparto solo puede hablar de las opciones que hay. */
			const validas = opciones();
			estado.reparto = Object.fromEntries(
				Object.entries(estado.reparto).filter(([id]) => validas.includes(id)),
			);
			if (!validas.includes(estado.ganadora)) estado.ganadora = validas[0];
			for (const b of qa<HTMLButtonElement>(".persona")) {
				const activo = personas.includes(b.dataset.persona!);
				marcarChip(b, activo);
				(b.querySelector(".marca") as HTMLElement).hidden = !activo;
			}
			const aviso = q<HTMLElement>("#sim-minimo");
			if (personas.length >= 2) aviso.style.color = "";
		}

		for (const b of qa<HTMLButtonElement>(".persona")) {
			b.addEventListener("click", () => {
				const p = b.dataset.persona!;
				elegirPersonas(
					estado.personas.includes(p)
						? estado.personas.filter((x) => x !== p)
						: [...estado.personas, p],
				);
				animate(b, { scale: [1, 0.94, 1] }, { duration: 0.25 });
			});
		}

		function pintarInterruptor() {
			const on = estado.conArbitro;
			interruptor.setAttribute("aria-checked", String(on));
			interruptor.style.background = on
				? "var(--color-success)"
				: "var(--color-hairline)";
			animate(
				interruptor.querySelector(".perilla") as HTMLElement,
				{ x: on ? 20 : 0 },
				MUELLE,
			);
		}

		interruptor.addEventListener("click", () => {
			estado.conArbitro = !estado.conArbitro;
			pintarInterruptor();
			cambiarDentro(pintarVisibilidad);
		});

		/* ── Paso 2 ────────────────────────────────────────────── */

		function pintarProb() {
			const p = Number(deslizador.value);
			estado.prob = p;
			valor.textContent = p + " %";
			valor.style.color = colorProb(p);
			cobardia.hidden = p !== 50;
		}

		deslizador.addEventListener("input", () => {
			pintarProb();
			animate(valor, { scale: [1.04, 1] }, { duration: 0.18 });
		});

		sellar.addEventListener("click", () => {
			sellar.textContent = "Pronóstico sellado";
			sellar.style.background = "var(--color-success)";
			animate(sellar, { scale: [1, 0.96, 1] }, { duration: 0.3 });
			animate(valor, { scale: [1, 1.12, 1], rotate: [0, -2, 0] }, MUELLE);
		});

		const botonPaso =
			"flex h-9 w-9 shrink-0 items-center justify-center rounded-full border text-lg leading-none transition-opacity disabled:opacity-30";

		/**
		 * El reparto. Las filas se construyen al entrar (o al cambiar las
		 * opciones) y luego solo se actualizan: reconstruirlas en cada toque
		 * mataría la animación de las barras.
		 */
		function pintarReparto(reconstruir = false) {
			const ops = opciones();
			if (reconstruir || listaReparto.children.length !== ops.length) {
				listaReparto.innerHTML = ops
					.map(
						(o) => `
						<li class="grid gap-1.5" data-opcion="${o}">
							<div class="flex items-center gap-3">
								<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold" style="background:var(--color-primary-soft);color:var(--color-${o === NADIE ? "muted" : "primary"})">${cara(o)}</span>
								<span class="min-w-0 flex-1 truncate text-[15px]" style="color:var(--color-${o === NADIE ? "secondary" : "foreground"})">${o}</span>
								<button type="button" class="menos ${botonPaso}" style="border-color:var(--color-hairline);color:var(--color-foreground)" aria-label="Bajar ${o}">−</button>
								<span class="valor w-12 text-center font-bold text-lg tabular-nums" style="color:var(--color-foreground)">0%</span>
								<button type="button" class="mas ${botonPaso}" style="border-color:var(--color-hairline);color:var(--color-foreground)" aria-label="Subir ${o}">+</button>
							</div>
							<div class="h-1.5 overflow-hidden rounded-full" style="background:var(--color-hairline)">
								<span class="barra block h-full rounded-full transition-[width,background-color] duration-300" style="width:0%"></span>
							</div>
						</li>`,
					)
					.join("");

				for (const fila of [...listaReparto.children] as HTMLElement[]) {
					const id = fila.dataset.opcion!;
					fila.querySelector(".menos")!.addEventListener("click", () => {
						estado.reparto = mover(estado.reparto, id, -PASO);
						pintarReparto();
					});
					fila.querySelector(".mas")!.addEventListener("click", () => {
						estado.reparto = mover(estado.reparto, id, PASO);
						pintarReparto();
					});
				}
			}

			const falta = quedan(estado.reparto);
			const repartido = 100 - falta;
			const colores = coloresDeReparto(estado.reparto);

			for (const fila of [...listaReparto.children] as HTMLElement[]) {
				const id = fila.dataset.opcion!;
				const v = estado.reparto[id] ?? 0;
				(fila.querySelector(".valor") as HTMLElement).textContent = v + "%";
				const barra = fila.querySelector(".barra") as HTMLElement;
				barra.style.width = v + "%";
				barra.style.background = colores[id] ?? "transparent";
				(fila.querySelector(".menos") as HTMLButtonElement).disabled = v <= 0;
				(fila.querySelector(".mas") as HTMLButtonElement).disabled = falta <= 0;
			}

			const total = q<HTMLElement>("#sim-repartido");
			total.textContent = repartido + "%";
			total.style.color =
				falta === 0 ? "var(--color-success)" : "var(--color-primary)";
			const barraTotal = q<HTMLElement>("#sim-repartido-barra");
			barraTotal.style.background = total.style.color;
			animate(barraTotal, { width: repartido + "%" }, MUELLE_SUAVE);

			const resto = q<HTMLElement>("#sim-quedan");
			resto.textContent = falta === 0 ? "Repartido el 100%" : `Te quedan ${falta}%`;
			resto.style.color =
				falta === 0 ? "var(--color-success)" : "var(--color-muted)";

			sellarReparto.disabled = falta !== 0;
			sellarReparto.textContent = "Sellar mi reparto";
			sellarReparto.style.background = "";
		}

		sellarReparto.addEventListener("click", () => {
			sellarReparto.textContent = "Reparto sellado";
			sellarReparto.style.background = "var(--color-success)";
			animate(sellarReparto, { scale: [1, 0.96, 1] }, { duration: 0.3 });
		});

		/** La elección de árbitro (`eleccion-arbitro.tsx`). */
		function pintarEleccion() {
			const votos = Object.values(estado.votosArbitro);
			const cuenta = (c: string) => votos.filter((v) => v === c).length;
			/* La barra se mide contra el más votado, como en la app. */
			const lider = Math.max(1, ...LIGA.map(cuenta));
			const miVoto = estado.votosArbitro["Tú"];

			eleccion.innerHTML = LIGA.map((c) => {
				const n = cuenta(c);
				const yo = c === "Tú";
				const elegido = miVoto === c;
				return `
					<li>
						<button type="button" data-candidato="${c}" ${yo ? "disabled" : ""}
							class="w-full rounded-2xl border px-4 py-3 text-left transition-colors"
							style="border-color:var(--color-${elegido ? "warning" : "hairline"});background:var(--color-${elegido ? "warning-soft" : "surface"});${yo ? "opacity:.6;cursor:default" : ""}"
							aria-label="${yo ? `Tú, con ${n} votos. No puedes votarte a ti mismo` : `Votar a ${c} como árbitro`}">
							<span class="flex items-center gap-2.5">
								<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold" style="background:var(--color-primary-soft);color:var(--color-primary)">${cara(c)}</span>
								<span class="flex-1 text-[15px]" style="color:var(--color-${elegido ? "foreground" : "secondary"});font-weight:${elegido ? 600 : 400}">${c}${yo ? '<span style="color:var(--color-muted)"> · no puedes votarte</span>' : ""}</span>
								${elegido ? '<span style="color:var(--color-warning)">✓</span>' : ""}
								<span class="font-bold text-sm tabular-nums" style="color:var(--color-foreground)">${n}</span>
							</span>
							${n > 0 ? `<span class="mt-2 block h-1.5 overflow-hidden rounded-full" style="background:var(--color-hairline)"><span class="block h-full rounded-full" style="width:${(n / lider) * 100}%;background:var(--color-warning)"></span></span>` : ""}
						</button>
					</li>`;
			}).join("");

			for (const b of eleccion.querySelectorAll<HTMLButtonElement>("[data-candidato]:not([disabled])")) {
				b.addEventListener("click", () => {
					estado.votosArbitro["Tú"] = b.dataset.candidato!;
					pintarEleccion();
					animate(
						eleccion.querySelector(`[data-candidato="${b.dataset.candidato}"]`)!,
						{ scale: [1, 0.97, 1] },
						{ duration: 0.25 },
					);
				});
			}
		}

		/* ── Paso 3 ────────────────────────────────────────────── */

		/** Quién entra en el destape de una Múltiple: tú, solo si llegaste a 100. */
		function repartosDelGrupo() {
			const ops = opciones();
			const filas = NOMBRES_RIVALES.map((n) => ({
				nombre: n,
				reparto: repartoDe(n, ops),
			}));
			return repartoCompleto()
				? [{ nombre: "Tú", reparto: estado.reparto }, ...filas]
				: filas;
		}

		function destapar() {
			if (multiple()) return destaparMultiple();

			const todos = [{ nombre: "Tú", prob: estado.prob }, ...RIVALES];

			destape.innerHTML = todos
				.map(
					(j) => `
					<li class="flex items-center gap-3 rounded-xl border border-hairline bg-card px-4 py-2.5" style="${j.nombre === "Tú" ? "background:var(--color-primary-soft)" : ""}">
						<span class="w-14 shrink-0 text-sm" style="color:var(--color-${j.nombre === "Tú" ? "foreground" : "secondary"})">${j.nombre}</span>
						<span class="h-2 flex-1 overflow-hidden rounded-full" style="background:var(--color-hairline)">
							<span class="barra block h-full rounded-full" style="width:0%;background:${colorProb(j.prob)}"></span>
						</span>
						<span class="w-14 shrink-0 text-right font-semibold text-sm tabular-nums" style="color:${colorProb(j.prob)}">${j.prob} %</span>
					</li>`,
				)
				.join("");

			const filas = [...destape.children] as HTMLElement[];
			animate(
				filas,
				{ opacity: [0, 1], y: [16, 0], scale: [0.96, 1] },
				{ ...MUELLE, delay: stagger(0.08) },
			);
			llenar(
				filas.map((f) => f.querySelector(".barra") as HTMLElement),
				todos.map((j) => j.prob),
			);

			const prom = Math.round(
				todos.reduce((a, j) => a + j.prob, 0) / todos.length,
			);
			numero(media, 0, prom, " %");
			media.style.color = colorProb(prom);
		}

		function destaparMultiple() {
			const ops = opciones();
			const grupo = repartosDelGrupo();
			const medias: Reparto = Object.fromEntries(
				ops.map((o) => [
					o,
					Math.round(
						grupo.reduce((a, r) => a + (r.reparto[o] ?? 0), 0) / grupo.length,
					),
				]),
			);
			const colores = coloresDeReparto(medias);

			const listaMedias = q<HTMLElement>("#sim-medias");
			listaMedias.innerHTML = ops
				.map(
					(o) => `
					<li class="grid gap-1.5">
						<div class="flex items-center gap-3">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold" style="background:var(--color-primary-soft);color:var(--color-${o === NADIE ? "muted" : "primary"})">${cara(o)}</span>
							<span class="flex-1 text-[15px] font-medium" style="color:var(--color-foreground)">${o}</span>
							<span class="font-bold text-lg tabular-nums" style="color:var(--color-foreground)">${medias[o]}%</span>
						</div>
						<div class="h-1.5 overflow-hidden rounded-full" style="background:var(--color-hairline)">
							<span class="barra block h-full rounded-full" style="width:0%;background:${colores[o] ?? "transparent"}"></span>
						</div>
					</li>`,
				)
				.join("");
			llenar(
				[...listaMedias.querySelectorAll<HTMLElement>(".barra")],
				ops.map((o) => medias[o]),
			);

			/* De más a menos y sin los 0, como en «Cómo repartió cada uno». */
			const listaRepartos = q<HTMLElement>("#sim-repartos");
			listaRepartos.innerHTML = grupo
				.map((r, i) => {
					const tu = r.nombre === "Tú";
					const linea = Object.entries(r.reparto)
						.filter(([, p]) => p > 0)
						.sort(([, a], [, b]) => b - a)
						.map(([o, p]) => `${o === "Tú" ? "tú" : o} ${p}%`)
						.join(" · ");
					return `
					<li class="px-4 py-3 ${i > 0 ? "border-t" : ""}" style="border-color:var(--color-hairline);${tu ? "background:var(--color-primary-soft)" : ""}">
						<p class="text-[15px] font-medium" style="color:var(--color-foreground)">${r.nombre}</p>
						<p class="text-xs tabular-nums" style="color:var(--color-muted)">${linea}</p>
					</li>`;
				})
				.join("");
			animate(
				[...listaRepartos.children] as HTMLElement[],
				{ opacity: [0, 1], y: [12, 0] },
				{ ...MUELLE, delay: stagger(0.07, { startDelay: 0.1 }) },
			);

			for (const aviso of qa<HTMLElement>("[data-sin-reparto]")) {
				aviso.hidden = repartoCompleto();
			}
		}

		q<HTMLButtonElement>("#sim-repetir").addEventListener("click", destapar);

		/* ── Paso 4 ────────────────────────────────────────────── */

		const anular = q<HTMLButtonElement>("#sim-anular");

		function pintarResolver() {
			pintarResultado();
			pintarGanadoras();
			anular.setAttribute("aria-pressed", String(estado.anulada));
			anular.style.background = estado.anulada ? "var(--color-hairline)" : "";
			anular.style.color = estado.anulada
				? "var(--color-foreground)"
				: "var(--color-secondary)";
		}

		function pintarResultado() {
			for (const b of qa<HTMLButtonElement>(".resultado")) {
				const si = b.dataset.resultado === "si";
				const activo = !estado.anulada && estado.resultado === si;
				const color = si ? "var(--color-success)" : "var(--color-danger)";
				b.setAttribute("aria-pressed", String(activo));
				b.style.borderColor = color;
				b.style.background = activo ? color : "transparent";
				b.style.color = activo ? "var(--color-on-primary)" : color;
			}
		}

		for (const b of qa<HTMLButtonElement>(".resultado")) {
			b.addEventListener("click", () => {
				estado.resultado = b.dataset.resultado === "si";
				estado.anulada = false;
				animate(b, { scale: [1, 0.95, 1] }, { duration: 0.28 });
				pintarResolver();
			});
		}

		/** «¿Quién fue al final?»: elegir la opción ganadora. */
		function pintarGanadoras() {
			const lista = q<HTMLElement>("#sim-ganadoras");
			lista.innerHTML = opciones()
				.map((o) => {
					const marcada = !estado.anulada && estado.ganadora === o;
					return `
					<li>
						<button type="button" data-ganadora="${o}" role="radio" aria-checked="${marcada}"
							class="flex w-full items-center gap-3 rounded-2xl border px-4 py-3 text-left transition-colors"
							style="border-color:var(--color-${marcada ? "success" : "hairline"});background:var(--color-${marcada ? "success-soft" : "surface"})">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold" style="background:var(--color-primary-soft);color:var(--color-${o === NADIE ? "muted" : "primary"})">${cara(o)}</span>
							<span class="flex-1 text-[15px]" style="color:var(--color-${marcada ? "foreground" : "secondary"});font-weight:${marcada ? 600 : 400}">${o}</span>
							${marcada ? '<span style="color:var(--color-success)">✓</span>' : ""}
						</button>
					</li>`;
				})
				.join("");

			for (const b of lista.querySelectorAll<HTMLButtonElement>("[data-ganadora]")) {
				b.addEventListener("click", () => {
					estado.ganadora = b.dataset.ganadora!;
					estado.anulada = false;
					pintarResolver();
				});
			}
		}

		anular.addEventListener("click", () => {
			estado.anulada = !estado.anulada;
			animate(anular, { scale: [1, 0.96, 1] }, { duration: 0.25 });
			pintarResolver();
		});

		/* ── Paso 5 ────────────────────────────────────────────── */

		function pintarMarcador() {
			const anulada = estado.anulada;
			q<HTMLElement>("#sim-anulada").hidden = !anulada;
			q<HTMLElement>("#sim-marcador").hidden = anulada;
			if (anulada) return;

			const medallas = [
				"var(--color-oro)",
				"var(--color-plata)",
				"var(--color-bronce)",
			];
			const resumen = q<HTMLElement>("#sim-resumen");
			const miIndice = q<HTMLElement>("#sim-mi-indice");
			q<HTMLElement>("#sim-formula-multiple").hidden = !multiple();

			let clasificacion: {
				nombre: string;
				dato: string;
				indice: number;
				escondido: boolean;
			}[];

			if (multiple()) {
				const ganadora = estado.ganadora;
				const tuyo = repartoCompleto();
				miIndice.hidden = !tuyo;
				resumen.innerHTML = tuyo
					? `${ganadora === "Tú" ? "Te" : "Le"} diste <span class="font-semibold" style="color:var(--color-foreground)">${estado.reparto[ganadora] ?? 0} %</span> a ${ganadora === "Tú" ? "ti" : ganadora}, y ${ganadora === "Tú" ? "ganaste tú" : `ganó ${ganadora}`}. Cuanto más le diste a quien ganó, mejor.`
					: "Tu reparto no llegaba al 100 %, así que esta no te puntúa. Vuelve al paso 2 y termina de repartir.";
				if (tuyo) {
					const indice = indiceMultiple(estado.reparto, ganadora);
					const el = q<HTMLElement>("#sim-indice");
					numero(el, 0, indice);
					el.style.color = colorProb(indice);
					q<HTMLElement>("#sim-brier").textContent = brierMultiple(
						estado.reparto,
						ganadora,
					).toFixed(3);
				}
				clasificacion = repartosDelGrupo().map((r) => ({
					nombre: r.nombre,
					dato: `${r.reparto[ganadora] ?? 0} % a ${ganadora === "Tú" ? "ti" : ganadora}`,
					indice: indiceMultiple(r.reparto, ganadora),
					escondido: false,
				}));
			} else {
				const ocurrio = estado.resultado;
				const p = estado.prob;
				miIndice.hidden = false;
				resumen.innerHTML = `Dijiste <span class="font-semibold" style="color:var(--color-foreground)">${p} %</span> y <span class="font-semibold" style="color:var(--color-foreground)">${ocurrio ? "sí ocurrió" : "no ocurrió"}</span>`;

				const indice = indiceDe(p, ocurrio);
				const el = q<HTMLElement>("#sim-indice");
				numero(el, 0, indice);
				el.style.color = colorProb(indice);
				q<HTMLElement>("#sim-brier").textContent = brierDe(p, ocurrio).toFixed(3);

				clasificacion = [{ nombre: "Tú", prob: p }, ...RIVALES].map((j) => ({
					nombre: j.nombre,
					dato: `${j.prob} %`,
					indice: indiceDe(j.prob, ocurrio),
					escondido: j.prob === 50,
				}));
			}

			clasificacion.sort((a, b) => b.indice - a.indice);

			tabla.innerHTML = clasificacion
				.map((j, i) => {
					const tu = j.nombre === "Tú";
					return `
					<li class="flex items-center gap-3 px-4 py-3 ${i > 0 ? "border-t" : ""}" style="border-color:var(--color-hairline);${tu ? "background:var(--color-primary-soft)" : ""}">
						<span class="w-6 shrink-0 text-center font-bold text-sm tabular-nums" style="color:${medallas[i] ?? "var(--color-muted)"}">${i + 1}</span>
						<span class="flex-1 text-sm" style="color:var(--color-${tu ? "foreground" : "secondary"});font-weight:${tu ? 600 : 400}">${j.nombre}${j.escondido ? '<span class="block text-xs" style="color:var(--color-muted);font-weight:400">sin mojarse</span>' : ""}</span>
						<span class="text-right text-sm tabular-nums" style="color:var(--color-muted)">${j.dato}</span>
						<span class="w-10 shrink-0 text-right font-semibold text-sm tabular-nums" style="color:var(--color-foreground)">${j.indice}</span>
					</li>`;
				})
				.join("");

			animate(
				[...tabla.children] as HTMLElement[],
				{ opacity: [0, 1], x: [-14, 0] },
				{ ...MUELLE, delay: stagger(0.06, { startDelay: 0.15 }) },
			);
		}

		/* ── Navegación ────────────────────────────────────────── */

		for (const paso of pasos) {
			paso.addEventListener("click", () => irA(Number(paso.dataset.paso)));
		}
		siguiente.addEventListener("click", () => {
			irA(estado.paso === paneles.length ? 1 : estado.paso + 1);
		});
		atras.addEventListener("click", () => irA(estado.paso - 1));

		elegirTipo("binaria");
		elegirSujeto("Nadie en concreto");
		elegirPersonas(estado.personas);
		pintarInterruptor();
		pintarProb();
		pintarStepper();
		for (const eco of qa<HTMLElement>("[data-eco-pregunta]")) {
			eco.textContent = textoPregunta();
		}
	}
</script>
