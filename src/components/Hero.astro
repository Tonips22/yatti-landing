---
import BotonTienda from "./BotonTienda.astro";

/**
 * Enlaces de las tiendas.
 *
 * A `null` mientras la app no esté publicada: el botón se pinta desactivado
 * con «Próximamente». Al publicar, basta con poner aquí la URL.
 *
 * Android: https://play.google.com/store/apps/details?id=com.tonips22.yatti
 * iOS:     https://apps.apple.com/es/app/yatti/id<ID que asigne App Store>
 */
const ENLACE_IOS: string | null = null;
const ENLACE_ANDROID: string | null = null;
---

<section
	class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-5 pt-28 pb-16 text-center"
>
	<div
		class="-z-10 pointer-events-none absolute inset-0"
		style="background:radial-gradient(60rem 40rem at 50% -10%, var(--color-primary-soft), transparent 70%)"
		aria-hidden="true"
	>
	</div>

	<img
		src="/marca/yatti-logo-gradient.png"
		alt="Yatti!"
		width="260"
		height="76"
		class="mb-8 h-14 w-auto sm:h-20"
	/>

	<p
		class="mb-6 inline-block rounded-full px-4 py-1.5 font-medium text-xs sm:text-sm"
		style="background:var(--color-primary-soft);color:var(--color-primary)"
	>
		Sin dinero · Sin apuestas · Solo ligas privadas
	</p>

	<h1
		class="w-full max-w-3xl font-[family-name:var(--font-heading)] text-4xl text-[color:var(--color-foreground)] leading-[1.1] sm:text-6xl"
		style="font-weight:700"
	>
		Predice la vida de tus amigos
	</h1>

	<p
		class="mt-6 w-full max-w-xl text-[color:var(--color-secondary)] text-lg leading-relaxed"
	>
		En tu grupo ya hacéis predicciones todo el rato. Yatti les pone porcentaje,
		fecha y clasificación. Y no gana quien más acierta: <strong
			class="text-[color:var(--color-foreground)]">gana quien mejor calibra</strong
		>.
	</p>

	<div class="mt-10 flex flex-col gap-3 sm:flex-row">
		<BotonTienda tienda="ios" enlace={ENLACE_IOS}>
			<svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
				></path>
			</svg>
		</BotonTienda>

		<BotonTienda tienda="android" enlace={ENLACE_ANDROID}>
			<svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path
					d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM16.089 7.79L4.194 1.061 14.607 11.4zM4.194 22.939l11.895-6.72-1.482-1.494zM3.031 1.492v21.016l10.567-10.508z"
				></path>
			</svg>
		</BotonTienda>
	</div>

	<a
		href="#como-funciona"
		class="group mt-14 inline-flex flex-col items-center gap-2 text-[color:var(--color-muted)] text-sm transition-colors hover:text-[color:var(--color-primary)]"
	>
		Cómo funciona
		<svg
			class="h-5 w-5 animate-bounce"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M12 5v14M19 12l-7 7-7-7"></path>
		</svg>
	</a>
</section>
