---
import { ENLACES_TIENDA } from "@/datos/tiendas";

const ANIO = new Date().getFullYear();

/** `null` mientras la app no esté publicada: ver `src/datos/tiendas.ts`. */
const ENLACES = [
	{ texto: "App Store", href: ENLACES_TIENDA.ios, externo: true },
	{ texto: "Google Play", href: ENLACES_TIENDA.android, externo: true },
	{ texto: "Privacidad y términos", href: "/privacidad", externo: false },
	{ texto: "Eliminar tu cuenta", href: "/eliminar-cuenta", externo: false },
];
---

<footer class="transicion-tema border-hairline border-t bg-surface">
	<div
		class="mx-auto flex max-w-4xl flex-col items-center gap-7 px-5 py-12 sm:flex-row sm:justify-between"
	>
		<a href="/" aria-label="Yatti, inicio">
			<img
				src="/marca/yatti-logo-gradient.png"
				alt="Yatti!"
				width="90"
				height="26"
				class="h-7 w-auto"
			/>
		</a>

		<nav
			class="flex flex-wrap justify-center gap-x-6 gap-y-2.5 text-sm sm:justify-end"
		>
			{
				ENLACES.map((e) =>
					e.href ? (
						<a
							href={e.href}
							target={e.externo ? "_blank" : undefined}
							rel={e.externo ? "noopener" : undefined}
							class="text-secondary transition-colors hover:text-primary"
						>
							{e.texto}
						</a>
					) : (
						<span class="text-muted" aria-disabled="true">
							{e.texto} <span class="text-xs">· próximamente</span>
						</span>
					),
				)
			}
		</nav>
	</div>

	<p
		class="flex items-center justify-center gap-1.5 pb-10 text-center text-muted text-xs"
	>
		© {ANIO} Yatti! · Hecho con
		<svg
			class="h-3.5 w-3.5 text-danger"
			viewBox="0 0 24 24"
			fill="currentColor"
			aria-hidden="true"
		>
			<path
				d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
			></path>
		</svg>
		<span class="sr-only">amor</span>
		en España
	</p>
</footer>
