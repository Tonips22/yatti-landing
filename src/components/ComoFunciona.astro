---
/**
 * Simulación jugable del ciclo de una predicción.
 *
 * El porcentaje y el desenlace que elige el visitante se propagan al paso de
 * puntuación con la MISMA fórmula que la app (`lib/prediccion.ts`), porque lo
 * que hay que entender aquí no es que haya puntos, sino por qué un 95 % fallado
 * duele más que un 60 % fallado. Si cambia la fórmula allí, cambia aquí.
 */
const PASOS = [
	{ n: 1, nombre: "Crear" },
	{ n: 2, nombre: "Pronosticar" },
	{ n: 3, nombre: "Resolver" },
	{ n: 4, nombre: "Puntuar" },
];

const MODOS = [
	{
		nombre: "Confianza",
		texto: "Quien la creó dice si pasó y punto. Cero fricción, para grupos que se fían.",
	},
	{
		nombre: "Justo",
		texto:
			"Se propone un resultado y se abre una ventana para disputarlo. Quien discrepe escribe su motivo a la vista de todos y el grupo vota.",
	},
	{
		nombre: "Árbitro",
		texto:
			"El juez se vota AL CREAR la predicción, cuando nadie sabe por dónde va a salir. Así nadie elige a un árbitro que le convenga.",
	},
];

const RIVALES = ["Marta", "Dani", "Laura", "Iván"];

const PREGUNTA = "¿Aguantará Laura la dieta hasta fin de mes?";
---

<section id="como-funciona" class="mx-auto max-w-4xl px-5 py-24">
	<div class="revelar text-center">
		<h2
			class="font-[family-name:var(--font-heading)] text-3xl text-[color:var(--color-foreground)] sm:text-4xl"
			style="font-weight:700"
		>
			Cómo funciona
		</h2>
		<p class="mx-auto mt-4 max-w-xl text-[color:var(--color-secondary)] leading-relaxed">
			Una predicción entera, de principio a fin. Mueve el porcentaje y elige el
			desenlace: los puntos salen con la misma fórmula que usa la app.
		</p>
	</div>

	<div id="simulacion" class="revelar mt-12">
		<ol class="flex flex-wrap justify-center gap-2" role="tablist" aria-label="Pasos">
			{
				PASOS.map((paso) => (
					<li>
						<button
							type="button"
							role="tab"
							class="paso transicion-tema flex items-center gap-2 rounded-full border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] px-4 py-2 font-medium text-[color:var(--color-muted)] text-sm"
							data-paso={paso.n}
							aria-selected={paso.n === 1 ? "true" : "false"}
						>
							<span class="numero flex h-5 w-5 items-center justify-center rounded-full text-[11px]">
								{paso.n}
							</span>
							{paso.nombre}
						</button>
					</li>
				))
			}
		</ol>

		<div
			class="transicion-tema mt-8 rounded-3xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-surface)] p-5 sm:p-8"
		>
			{/* ── 1 · Crear ─────────────────────────────────────────── */}
			<div class="panel" data-panel="1" role="tabpanel">
				<h3
					class="font-[family-name:var(--font-heading)] text-[color:var(--color-foreground)] text-xl"
					style="font-weight:700"
				>
					Alguien lanza una predicción
				</h3>
				<p class="mt-2 text-[color:var(--color-secondary)] leading-relaxed">
					Dentro de una liga privada, con sus amigos y nadie más. Se escribe el
					enunciado, se pone fecha de cierre y se elige cómo va a resolverse.
				</p>

				<div
					class="transicion-tema mt-6 rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] p-5"
				>
					<div class="flex items-center gap-2 text-[color:var(--color-muted)] text-xs">
						<span
							class="rounded-full px-2 py-0.5 font-medium"
							style="background:var(--color-primary-soft);color:var(--color-primary)"
						>
							La Peña
						</span>
						<span>9 miembros</span>
					</div>
					<p
						class="mt-3 font-[family-name:var(--font-heading)] text-[color:var(--color-foreground)] text-lg"
						style="font-weight:700"
					>
						{PREGUNTA}
					</p>
					<div
						class="mt-4 flex flex-wrap items-center gap-3 border-[color:var(--color-hairline)] border-t pt-4 text-[color:var(--color-muted)] text-sm"
					>
						<span>Cierra el 30 de septiembre</span>
						<span
							class="rounded-full px-2.5 py-1 font-medium text-xs"
							style="background:var(--color-accent-soft);color:var(--color-accent)"
						>
							Modo Justo
						</span>
					</div>
				</div>

				<div class="mt-6 grid gap-3 sm:grid-cols-3">
					{
						MODOS.map((modo) => (
							<div class="transicion-tema rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] p-4">
								<p class="font-semibold text-[color:var(--color-foreground)] text-sm">
									Modo {modo.nombre}
								</p>
								<p class="mt-1.5 text-[color:var(--color-muted)] text-[13px] leading-relaxed">
									{modo.texto}
								</p>
							</div>
						))
					}
				</div>
			</div>

			{/* ── 2 · Pronosticar ───────────────────────────────────── */}
			<div class="panel" data-panel="2" role="tabpanel" hidden>
				<h3
					class="font-[family-name:var(--font-heading)] text-[color:var(--color-foreground)] text-xl"
					style="font-weight:700"
				>
					Cada uno pone su porcentaje
				</h3>
				<p class="mt-2 text-[color:var(--color-secondary)] leading-relaxed">
					10 % si lo ves imposible, 90 % si lo tienes clarísimo. Nadie ve el
					porcentaje de los demás hasta que se cierra el plazo, así que no hay
					efecto rebaño.
				</p>

				<div
					class="transicion-tema mt-6 rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] p-5 sm:p-6"
				>
					<p class="text-[color:var(--color-muted)] text-sm">{PREGUNTA}</p>

					<p
						id="sim-valor"
						class="mt-4 text-center font-[family-name:var(--font-heading)] text-6xl tabular-nums sm:text-7xl"
						style="font-weight:700"
						aria-hidden="true"
					>
						70 %
					</p>

					<label for="sim-prob" class="solo-lectores">
						Tu porcentaje para esta predicción
					</label>
					<input
						id="sim-prob"
						type="range"
						min="0"
						max="100"
						step="5"
						value="70"
						class="mt-4 w-full"
					/>

					<p
						id="sim-cobardia"
						class="mt-4 rounded-xl px-3 py-2 text-[13px] leading-relaxed"
						style="background:var(--color-warning-soft);color:var(--color-warning)"
						hidden
					>
						Un 50 % clavado es no mojarse: nunca te hundes, pero nunca ganas. El
						que no se moja jamás es el peor jugador de la liga.
					</p>

					<div
						class="mt-5 flex items-center gap-2 border-[color:var(--color-hairline)] border-t pt-4"
					>
						<span class="text-[color:var(--color-muted)] text-sm">Los demás:</span>
						{
							RIVALES.map((nombre) => (
								<span
									class="flex h-8 w-8 items-center justify-center rounded-full font-semibold text-[color:var(--color-muted)] text-xs"
									style="background:var(--color-primary-soft)"
									title={`El pronóstico de ${nombre} sigue oculto`}
								>
									?
								</span>
							))
						}
					</div>
				</div>
			</div>

			{/* ── 3 · Resolver ──────────────────────────────────────── */}
			<div class="panel" data-panel="3" role="tabpanel" hidden>
				<h3
					class="font-[family-name:var(--font-heading)] text-[color:var(--color-foreground)] text-xl"
					style="font-weight:700"
				>
					Llega la fecha y se resuelve
				</h3>
				<p class="mt-2 text-[color:var(--color-secondary)] leading-relaxed">
					Se cierra el plazo y se destapan todos los pronósticos a la vez. Tú
					decides cómo acabó:
				</p>

				<div class="mt-5 flex flex-col gap-3 sm:flex-row">
					<button
						type="button"
						class="resultado transicion-tema flex-1 rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] px-4 py-3 font-semibold text-[color:var(--color-secondary)]"
						data-ocurrio="si"
						aria-pressed="true"
					>
						Sí, lo aguantó
					</button>
					<button
						type="button"
						class="resultado transicion-tema flex-1 rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] px-4 py-3 font-semibold text-[color:var(--color-secondary)]"
						data-ocurrio="no"
						aria-pressed="false"
					>
						No, lo dejó
					</button>
				</div>

				<ul id="sim-pronosticos" class="mt-6 grid gap-2"></ul>

				<p class="mt-5 text-[color:var(--color-muted)] text-sm leading-relaxed">
					¿Y si la pregunta estaba mal hecha y no hay forma de resolverla? Se
					anula, y entonces no afecta a la puntuación de nadie.
				</p>
			</div>

			{/* ── 4 · Puntuar ───────────────────────────────────────── */}
			<div class="panel" data-panel="4" role="tabpanel" hidden>
				<h3
					class="font-[family-name:var(--font-heading)] text-[color:var(--color-foreground)] text-xl"
					style="font-weight:700"
				>
					La clasificación se mueve
				</h3>
				<p class="mt-2 text-[color:var(--color-secondary)] leading-relaxed">
					Yatti puntúa con el <strong class="text-[color:var(--color-foreground)]"
						>Brier score</strong
					>, el sistema que usan los forecasters serios. Premia acertar <em
						>y</em
					> ser honesto con tu confianza: decir 95 % y fallar duele mucho más que
					decir 60 % y fallar.
				</p>

				<div
					class="transicion-tema mt-6 rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)] p-5"
					aria-live="polite"
				>
					<p class="text-[color:var(--color-muted)] text-sm">
						Dijiste <span id="sim-resumen-prob" class="font-semibold">70 %</span> y <span id="sim-resumen-res" class="font-semibold">sí ocurrió</span>
					</p>
					<p class="mt-3 flex items-baseline gap-2">
						<span
							id="sim-indice"
							class="font-[family-name:var(--font-heading)] text-5xl tabular-nums"
							style="font-weight:700">91</span
						>
						<span class="text-[color:var(--color-muted)] text-sm">
							índice de acierto (0-100)
						</span>
					</p>
					<p class="mt-2 text-[color:var(--color-muted)] text-[13px]">
						Brier = <span id="sim-brier" class="tabular-nums">0.090</span> ·
						índice = (1 − Brier) × 100
					</p>
				</div>

				<p class="mt-8 mb-3 font-semibold text-[color:var(--color-foreground)] text-sm">
					Clasificación de la ronda
				</p>
				<ol
					id="sim-tabla"
					class="transicion-tema overflow-hidden rounded-2xl border border-[color:var(--color-glass-border)] bg-[color:var(--color-card)]"
				>
				</ol>
			</div>

			<button
				type="button"
				id="sim-siguiente"
				class="mt-8 w-full rounded-2xl bg-[color:var(--color-primary)] px-6 py-3.5 font-semibold text-[color:var(--color-on-primary)] transition-colors duration-200 hover:bg-[color:var(--color-primary-hover)]"
			>
				Siguiente paso
			</button>
		</div>
	</div>
</section>

<style>
	.solo-lectores {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.paso[aria-selected='true'] {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}
	.paso .numero {
		background: var(--color-primary-soft);
		color: var(--color-primary);
	}
	.paso[aria-selected='true'] .numero {
		background: var(--color-primary);
		color: var(--color-on-primary);
	}

	.resultado[aria-pressed='true'] {
		border-color: var(--color-primary);
		background: var(--color-primary-soft);
		color: var(--color-primary);
	}

	/* El pulgar del deslizador es EL gesto de la app, así que se pinta a mano:
	   el nativo sale en el azul del sistema y rompe la marca. */
	#sim-prob {
		appearance: none;
		-webkit-appearance: none;
		height: 2.5rem;
		background: transparent;
		cursor: pointer;
	}
	#sim-prob::-webkit-slider-runnable-track {
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-primary-soft);
	}
	#sim-prob::-webkit-slider-thumb {
		appearance: none;
		-webkit-appearance: none;
		margin-top: -0.5rem;
		height: 1.5rem;
		width: 1.5rem;
		border-radius: 999px;
		border: 3px solid var(--color-card);
		background: var(--color-primary);
		box-shadow: 0 2px 8px var(--color-scrim);
	}
	#sim-prob::-moz-range-track {
		height: 0.5rem;
		border-radius: 999px;
		background: var(--color-primary-soft);
	}
	#sim-prob::-moz-range-thumb {
		height: 1.5rem;
		width: 1.5rem;
		border-radius: 999px;
		border: 3px solid var(--color-card);
		background: var(--color-primary);
	}
</style>

<script>
	const RIVALES = [
		{ nombre: "Marta", prob: 85 },
		{ nombre: "Dani", prob: 40 },
		{ nombre: "Laura", prob: 60 },
		{ nombre: "Iván", prob: 50 },
	];

	/** Mismas fórmulas que `lib/prediccion.ts` en el repo de la app. */
	const brierDe = (prob: number, ocurrio: boolean) =>
		((ocurrio ? 1 : 0) - prob / 100) ** 2;
	const indiceDe = (prob: number, ocurrio: boolean) =>
		Math.round((1 - brierDe(prob, ocurrio)) * 100);

	/** Misma escala que `colorProbabilidad()` en la app. */
	function colorProb(valor: number) {
		if (valor >= 100) return "var(--color-prob-total)";
		if (valor >= 70) return "var(--color-prob-alta)";
		if (valor >= 50) return "var(--color-prob-media)";
		if (valor >= 30) return "var(--color-prob-baja)";
		return "var(--color-prob-muy-baja)";
	}

	const raiz = document.getElementById("simulacion");

	if (raiz) {
		const pasos = [...raiz.querySelectorAll<HTMLButtonElement>(".paso")];
		const paneles = [...raiz.querySelectorAll<HTMLElement>(".panel")];
		const botones = [...raiz.querySelectorAll<HTMLButtonElement>(".resultado")];
		const deslizador = raiz.querySelector("#sim-prob") as HTMLInputElement;
		const valor = raiz.querySelector("#sim-valor") as HTMLElement;
		const cobardia = raiz.querySelector("#sim-cobardia") as HTMLElement;
		const pronosticos = raiz.querySelector("#sim-pronosticos") as HTMLElement;
		const tabla = raiz.querySelector("#sim-tabla") as HTMLElement;
		const siguiente = raiz.querySelector("#sim-siguiente") as HTMLButtonElement;
		const resumenProb = raiz.querySelector("#sim-resumen-prob") as HTMLElement;
		const resumenRes = raiz.querySelector("#sim-resumen-res") as HTMLElement;
		const indice = raiz.querySelector("#sim-indice") as HTMLElement;
		const brier = raiz.querySelector("#sim-brier") as HTMLElement;

		let activo = 1;
		let ocurrio = true;

		function irA(n: number) {
			activo = n;
			for (const paso of pasos) {
				paso.setAttribute("aria-selected", String(Number(paso.dataset.paso) === n));
			}
			for (const panel of paneles) {
				panel.hidden = Number(panel.dataset.panel) !== n;
			}
			siguiente.textContent =
				n === paneles.length ? "Volver al principio" : "Siguiente paso";
		}

		function pintar() {
			const prob = Number(deslizador.value);
			const todos = [{ nombre: "Tú", prob }, ...RIVALES];

			valor.textContent = `${prob} %`;
			valor.style.color = colorProb(prob);
			cobardia.hidden = prob !== 50;

			pronosticos.innerHTML = todos
				.map(
					(jugador) => `
						<li class="transicion-tema flex items-center gap-3 rounded-xl border border-[color:var(--color-hairline)] bg-[color:var(--color-card)] px-4 py-2.5">
							<span class="w-14 shrink-0 text-sm" style="color:var(--color-${jugador.nombre === "Tú" ? "foreground" : "secondary"})">${jugador.nombre}</span>
							<span class="h-2 flex-1 overflow-hidden rounded-full" style="background:var(--color-hairline)">
								<span class="block h-full rounded-full" style="width:${jugador.prob}%;background:${colorProb(jugador.prob)}"></span>
							</span>
							<span class="w-14 shrink-0 text-right font-semibold text-sm tabular-nums" style="color:${colorProb(jugador.prob)}">${jugador.prob} %</span>
						</li>`,
				)
				.join("");

			resumenProb.textContent = `${prob} %`;
			resumenRes.textContent = ocurrio ? "sí ocurrió" : "no ocurrió";
			indice.textContent = String(indiceDe(prob, ocurrio));
			indice.style.color = colorProb(indiceDe(prob, ocurrio));
			brier.textContent = brierDe(prob, ocurrio).toFixed(3);

			const medallas = [
				"var(--color-oro)",
				"var(--color-plata)",
				"var(--color-bronce)",
			];
			tabla.innerHTML = todos
				.map((jugador) => ({ ...jugador, indice: indiceDe(jugador.prob, ocurrio) }))
				.sort((a, b) => b.indice - a.indice)
				.map((jugador, i) => {
					const eresTu = jugador.nombre === "Tú";
					return `
						<li class="flex items-center gap-3 px-4 py-3 ${i > 0 ? "border-[color:var(--color-hairline)] border-t" : ""}"
								style="${eresTu ? "background:var(--color-primary-soft)" : ""}">
							<span class="w-6 shrink-0 text-center font-bold text-sm tabular-nums" style="color:${medallas[i] ?? "var(--color-muted)"}">${i + 1}</span>
							<span class="flex-1 text-sm" style="color:var(--color-${eresTu ? "foreground" : "secondary"});font-weight:${eresTu ? 600 : 400}">${jugador.nombre}</span>
							<span class="text-sm tabular-nums" style="color:var(--color-muted)">${jugador.prob} %</span>
							<span class="w-10 shrink-0 text-right font-semibold text-sm tabular-nums" style="color:var(--color-foreground)">${jugador.indice}</span>
						</li>`;
				})
				.join("");
		}

		for (const paso of pasos) {
			paso.addEventListener("click", () => irA(Number(paso.dataset.paso)));
		}

		siguiente.addEventListener("click", () =>
			irA(activo === paneles.length ? 1 : activo + 1),
		);

		for (const boton of botones) {
			boton.addEventListener("click", () => {
				ocurrio = boton.dataset.ocurrio === "si";
				for (const otro of botones) {
					otro.setAttribute("aria-pressed", String(otro === boton));
				}
				pintar();
			});
		}

		deslizador.addEventListener("input", pintar);

		irA(1);
		pintar();
	}
</script>
