---
import CambiarTema from "./CambiarTema.astro";
---

<header class="fixed top-0 right-0 left-0 z-50">
	<div
		class="transicion-tema mx-auto flex max-w-5xl items-center justify-between border-[color:var(--color-glass-border)] border-b bg-[color:var(--color-glass)] px-5 py-3 backdrop-blur-xl sm:mt-4 sm:rounded-2xl sm:border"
	>
		<a href="/" class="flex items-center gap-2" aria-label="Yatti, inicio">
			<img
				src="/marca/yatti-logo-gradient.png"
				alt="Yatti!"
				width="90"
				height="26"
				class="h-6 w-auto"
			/>
		</a>

		<nav class="flex items-center gap-1 sm:gap-3">
			<a
				href="/#como-funciona"
				class="rounded-full px-3 py-2 text-[color:var(--color-secondary)] text-sm transition-colors hover:text-[color:var(--color-primary)]"
			>
				Cómo funciona
			</a>
			<CambiarTema />
		</nav>
	</div>
</header>
